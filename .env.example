# ==============================================================================
# Environment Variables Example for N24 Pilates & Wellness Website
# ==============================================================================

# Google Places API Key:
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Enable the "Places API" for this key.
GOOGLE_PLACES_API_KEY=your_google_places_api_key_here

# (Optional) Google Place ID for N24 Pilates & Wellness Studio:
# If left blank, the sync script will automatically look it up using the business name.
# Lookup tool: https://developers.google.com/maps/documentation/javascript/examples/places-placeid-finder
GOOGLE_PLACE_ID=
